# ── Railway auto-provides this ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/db   # provided by Railway PostgreSQL plugin

# ── Required ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-generate-with-python-secrets
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app

# ── CSRF & CORS (add your Vercel domain) ─────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-app.railway.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
